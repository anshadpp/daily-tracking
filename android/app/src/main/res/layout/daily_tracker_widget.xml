<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header: title (opens app) + refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Tracker"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#99FFFFFF"
            android:maxLines="1"
            android:letterSpacing="0.1" />

        <ImageButton
            android:id="@+id/widget_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Current/next block -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="All caught up"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap to open"
        android:textSize="11sp"
        android:textColor="#BBFFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/widget_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="0%  •  0 / 0"
        android:textSize="10sp"
        android:textColor="#99FFFFFF" />

    <!-- Prayers -->
    <TextView
        android:id="@+id/widget_prayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="10sp"
        android:textColor="#BBFFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Qada warning -->
    <TextView
        android:id="@+id/widget_qada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="10sp"
        android:textColor="#FFEF5350"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Todos (3 slots) -->
    <LinearLayout
        android:id="@+id/widget_todo_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TODOS"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#77FFFFFF"
            android:letterSpacing="0.15" />

        <!-- Todo 1 -->
        <LinearLayout
            android:id="@+id/widget_todo1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/widget_todo1_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/checkbox_off_background"
                android:contentDescription="Toggle todo" />

            <TextView
                android:id="@+id/widget_todo1_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="#DDFFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Todo 2 -->
        <LinearLayout
            android:id="@+id/widget_todo2_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/widget_todo2_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/checkbox_off_background"
                android:contentDescription="Toggle todo" />

            <TextView
                android:id="@+id/widget_todo2_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="#DDFFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Todo 3 -->
        <LinearLayout
            android:id="@+id/widget_todo3_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/widget_todo3_check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/checkbox_off_background"
                android:contentDescription="Toggle todo" />

            <TextView
                android:id="@+id/widget_todo3_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="#DDFFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mark current block done -->
    <Button
        android:id="@+id/widget_done_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="✓ Mark current done"
        android:textSize="11sp"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/widget_button_bg"
        android:stateListAnimator="@null" />

</LinearLayout>
